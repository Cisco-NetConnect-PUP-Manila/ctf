# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
BACKEND_PORT=8000
BACKEND_ENV=local
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=packet_capture_session
SESSION_COOKIE_SECURE=false
SESSION_EXPIRE_HOURS=12
REGISTRATION_OPEN_BY_DEFAULT=true

# PostgreSQL for local Docker Compose
POSTGRES_DB=packet_capture_ctf
POSTGRES_USER=packet_capture
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=5432

# Use this from your host machine.
DATABASE_URL=postgresql+psycopg://packet_capture:change_this_local_password@localhost:5432/packet_capture_ctf

# Use this from a backend container inside docker-compose.
DOCKER_DATABASE_URL=postgresql+psycopg://packet_capture:change_this_local_password@postgres:5432/packet_capture_ctf
