# Frontend
# Team-standard local ports. If they conflict, run scripts\docker-dev.cmd -AutoPorts.
FRONTEND_PORT=3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
BACKEND_INTERNAL_URL=http://localhost:8001

# Backend
BACKEND_PORT=8001
BACKEND_ENV=local
FRONTEND_ORIGIN=http://localhost:3001
SESSION_COOKIE_NAME=packet_capture_session
SESSION_COOKIE_SECURE=false
SESSION_EXPIRE_HOURS=12
REGISTRATION_OPEN_BY_DEFAULT=true

# Pepper for challenge flag validators. MUST be overridden with a unique random value in
# any non-local environment -- the backend refuses to start otherwise. Store it alongside
# your other secrets: if it is lost or rotated, every stored flag validator becomes
# unverifiable and all flags must be re-entered through the admin panel.
FLAG_HASH_SECRET=change-me-local-flag-hash-secret

# PostgreSQL for local Docker Compose
POSTGRES_DB=packet_capture_ctf
POSTGRES_USER=packet_capture
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=5433

# Use this from your host machine.
DATABASE_URL=postgresql+psycopg://packet_capture:change_this_local_password@localhost:5433/packet_capture_ctf

# Use this from a backend container inside docker-compose.
DOCKER_DATABASE_URL=postgresql+psycopg://packet_capture:change_this_local_password@postgres:5432/packet_capture_ctf
